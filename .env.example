# ==================== 行情数据源 ====================
# 数据源选择：gate 或 binance。当前机器建议使用 gate。
MARKET_DATA_SOURCE=gate
# Gate USDT 永续合约公开 API，无需 Gate API Key。
GATE_BASE_URL=https://api.gateio.ws
# Binance U 本位永续合约公开 API，无需 Binance API Key。
BINANCE_BASE_URL=https://fapi.binance.com

# 固定扫描合约，多个合约使用英文逗号分隔，例如：BTCUSDT,ETHUSDT,SOLUSDT。
# 留空时扫描 Gate 全部 USDT 永续合约，包括股票、ETF、贵金属等代币化合约，
# 并按 24 小时成交额从高到低自动选币。
SYMBOLS=
# 自动选币数量，仅在 SYMBOLS 留空时生效。
TOP_N=50
# 最低 24 小时成交额，单位为 USDT；低于该金额的合约不会进入扫描范围。
MIN_QUOTE_VOLUME_USDT=10000000
# 同时请求行情的最大并发数。数值过大可能触发交易所限流。
MAX_CONCURRENCY=8
# 实时扫描轮询间隔，单位为秒。
POLL_SECONDS=60

# ==================== ICT 信号参数 ====================
# FVG 方向定义：
# document = 严格按照交付规格书中的公式和方向。
# classic  = 使用常见 ICT FVG 方向，即向上缺口为 Bullish、向下缺口为 Bearish。
FVG_DEFINITION=document
# 1H FVG 最大有效时间，单位为小时，可设置 6-48。
FVG_MAX_AGE_HOURS=24
# FVG 完全回补判定：true 使用收盘价，false 使用影线；规格默认使用收盘价。
MITIGATION_USE_CLOSE=true
# 流动性水平触及容差，使用小数百分比；0.0005 表示 0.05%。
LIQUIDITY_TOLERANCE_PCT=0.0005
# 15M 摆动点左右需要比较的 K 线数量，可设置 1-3。
BOS_SWING_WINDOW=2
# ATR 周期，规格固定为 14。
BOS_ATR_PERIOD=14
# 相邻同向有效摆动点的最小价格距离，单位为 ATR 倍数，可设置 0.5-2.0。
BOS_MIN_ATR_MULT=1.0
# 流动性触及后等待 BOS 的最大 15M K 线数量，可设置 8-32。
BOS_TIMEOUT_BARS_15M=16
# BOS 后等待价格回踩 FVG 的最大 15M K 线数量，可设置 4-16。
ENTRY_TIMEOUT_BARS_15M=8
# 发出信号后的全局冷却时间，单位为 15M K 线数量，可设置 3-20。
COOLDOWN_BARS_15M=5

# ==================== 存储与日志 ====================
# SQLite 数据库路径，用于保存状态机、信号指纹和发送状态。
DATABASE_PATH=data/ict_signal.db
# 信号超过该分钟数时只写入数据库、不再发送 Telegram，防止补发旧信号。
STALE_SIGNAL_MINUTES=5
# 日志级别，可使用 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# ==================== Telegram ====================
# 配置好 TG_BOT_TOKEN 和 TG_CHAT_ID 后再改为 true。
TELEGRAM_ENABLED=false
# 从 Telegram 的 @BotFather 获取 Bot Token。不要提交真实 Token 到版本库。
TG_BOT_TOKEN=
# Telegram 目标用户、群组或频道 ID；频道也可以使用 @频道用户名。
TG_CHAT_ID=
